{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://ai-studio-applet-webapp-3b366.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/((?!api/|__/).*)",
      "destination": "/index.html"
    }
  ]
}
