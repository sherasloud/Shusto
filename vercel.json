{
  "functions": {
    "api/*.ts": {
      "includeFiles": "firebase-applet-config.json",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/direct-api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/((?!api/|direct-api/).*)",
      "destination": "/index.html"
    }
  ]
}
