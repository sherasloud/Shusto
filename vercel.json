{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://shustoorg.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/direct-api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|direct-api/|__/auth/).*)",
      "destination": "/index.html"
    }
  ]
}
